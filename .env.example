# =============================================================================
# Gemini 3.8 Live Scaffold — Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env

# --- Google Cloud / Vertex AI Configuration (Recommended for Cloud Run) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Supported regions for gemini-3.8-live: us-central1, asia-south1, us, eu
GOOGLE_CLOUD_LOCATION=us-central1

# --- Optional: Gemini Developer API Key (Alternative to Vertex AI) ---
# If you prefer using an API key instead of Vertex AI ADC:
# Set GOOGLE_GENAI_USE_VERTEXAI=false and provide GEMINI_API_KEY
# GEMINI_API_KEY=your-api-key-here

# --- Gemini 3.8 Live Model & Voice Settings ---
GEMINI_LIVE_MODEL=gemini-3.8-live
# Companion model used for grounded web search tool responses
GEMINI_SEARCH_MODEL=gemini-3.8-flash
# Prebuilt HD Voice (e.g., Aoede, Kore, Puck, Charon, Fenrir, Leda)
GEMINI_VOICE_NAME=Aoede
# BCP-47 language code (Bahasa Indonesia = id-ID)
GEMINI_LANGUAGE_CODE=id-ID

# --- Server Settings ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
